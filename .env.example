# Copy this file to .env.local and fill in your values.
# .env.local is ignored by Git, so your keys stay on your computer.
#
# Where to find them: Supabase dashboard -> your project -> Project Settings
# -> Data API (Project URL) and -> API Keys (anon / publishable key).
#
# ONLY the anon / publishable key goes here. Never the service_role / secret key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here

# Optional: test the github.io base path locally, e.g. BASE_PATH=/recoverydayalberta/
# BASE_PATH=/
